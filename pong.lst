ZX16 Assembler Listing
==================================================

   1      #---------- CONSTANTS ----------
   2      .equ TILE_MAP_BASE, 0x0000 # start of tile map buffer
   3      .equ TILE_MAP_SIZE, 300 # 20 * 15 tiles
   4      .equ BLANK_TILE, 0
   5      
   6      .equ ASCII_W, 119
   7      .equ ASCII_S, 115
   8      .equ ASCII_O, 111
   9      .equ ASCII_L, 108
  10      
  11      # Movement flags
  12      .equ STAY, 0
  13      .equ UP,   1
  14      .equ DOWN, 2
  15      
  16      # PADDLES
  17      .equ PADDLE_LENGTH, 5
  18      .equ TOP, 0 # max top where paddle can go up
  19      .equ BOTTOM, 9  # (SCREEN_HEIGHT - PADDLE_LENGTH - 1)  max bottom where paddle can go down
  20      .equ LEFT_X, 13
  21      .equ RIGHT_X, 18
  22      
  23      # BALL
  24      .equ BALL_START_X, 10
  25      .equ BALL_START_Y, 0
  26      .equ BALL_LEFT, -1
  27      .equ BALL_RIGHT, 1
  28      .equ BALL_UP, -1
  29      .equ BALL_DOWN, 1
  30      
  31      # TILE INDICES
  32      .equ PADDLE_TILE, 1
  33      .equ BALL_TILE, 2
  34      
  35      .equ GAME_WIN, 10 # win when reach 10 points
  36      
  37      
  38      #---------- DATA SECTION ----------
  39      .data
  40      p1_score: .word 0
  41      p2_score: .word 0
  42      p1_paddle_y: .word 7
  43      p2_paddle_y: .word 7
  44      ball_x: .word BALL_START_X
  45      ball_y: .word BALL_START_Y
  46      ball_dx: .word BALL_RIGHT
  47      ball_dy: .word BALL_DOWN
  48      ball_dy_wait:  .word 1# vertical speed counter
  49      
  50      
  51      #---------- TEXT SECTION ----------
  52      .org 0x0020
  53      .text
  54      
  55      
  56      # -- entry point for program ---
  57      main:
  58          # Initialize stack pointer
  59          li sp, 0xEFFE
  60      
  61          j setup_graphics
  62      
  63      # ----------------------------------------------
  64      
  65      setup_graphics:
  66          lui s0, 18 # load palette base address
  67          ori s0, 0x2C
  68      
  69          li t1, 0x03 # load blue
  70          sb t1, 4(s0)
  71      
  72          li t1, 0xFF # load white
  73          sb t1, 7(s0)
  74      
  75          # fill tile 1 (paddle) with blue 
  76          lui t0, 2  # load tile data base address
  77          ori t0, 0x2C
  78          ADDI t0, 128 # Offset to tile 1 (128 bytes per tile)
  79      
  80          li t1, 0x44
  81          li s0, 128
  82      
  83          fill_paddle:
  84              sb t1, 0(t0)
  85              addi t0, 1
  86              addi s0, -1
  87              bnz s0, fill_paddle
  88              
  89          draw_objects:
  90              # draw left paddle
  91              li a0, LEFT_X
  92              la t0, p1_paddle_y
  93              lw a1, 0(t0)
  94              li t0, PADDLE_TILE
  95              addi sp, -2
  96              sw t0, 0(sp)
  97              call draw_paddle
  98              addi sp, 2
  99              ret
 100      
 101          draw_paddle:
 102              lw s1, 0(sp) # tile index
 103              li s0, PADDLE_LENGTH
 104      
 105              draw_paddle_loop:
 106                  li t0, 20
 107                  # Compute a1 * 20 using shifts
 108                  sll t0, a1, 4       # t0 = y << 4 = y * 16
 109                  sll t1, a1, 2       # t1 = y << 2 = y * 4
 110                  add t0, t1      # t0 = y*16 + y*4 = y * 20
 111                  add t0, a0      # t0 += x
 112                  add t1, a0
 113                  li t0, TILE_MAP_BASE
 114                  add t1, t0
 115                  sb s1, 0(t1)
 116      
 117                  addi a1, 1
 118                  addi s0, -1
 119                  bnz s0, draw_paddle_loop
 120      
 121                  ecall 0x3FF
 122      
 123      
 124              
 125      
 126      
 127      
 128      
 129      
 130      
 131      
 132      # --- start the game ---
 133      start:
 134          
 135      
 136      # --- clears board to prepare for new game ---
 137      clear_game:
 138          li t0, TILE_MAP_BASE 
 139          li t1, BLANK_TILE
 140          lui s1, 2
 141          ori s1, 44 # load 300 into s1
 142      
 143          clear_loop:
 144              addi x0, 0
 145              addi x0, 0
 146              sb t1, 0(t0) # store blank tile at t[0]
 147              addi t0, 1 # t0++
 148              addi s1, -1 # t2--
 149              bge t1, s1, cleared
 150              j clear_loop
 151              cleared:
 152                  addi x0, 0
 153                  addi x0, 0
 154                  ecall 0x3FF
 155      # ----------------------------------------------

